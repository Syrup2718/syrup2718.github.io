---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
  <nav>
    <a href="/" class="site-title">
      <img src="/favicon.ico" alt="" class="site-logo" width="24" height="24" />
      {SITE_TITLE}
    </a>
    <div class="nav-links">
      <HeaderLink href="/" icon="fa-solid fa-house">首頁</HeaderLink>
      <HeaderLink href="/blog" icon="fa-regular fa-file-lines">筆記</HeaderLink>
      <HeaderLink href="/projects" icon="fa-solid fa-briefcase">專案</HeaderLink>
      <HeaderLink href="/about" icon="fa-regular fa-user">關於</HeaderLink>
    </div>
  </nav>
</header>

<style>
  header {
    padding: 1.5rem max(1.5rem, env(safe-area-inset-right)) 1.5rem max(1.5rem, env(safe-area-inset-left));
    border-bottom: 1px solid var(--border);
    background: var(--bg);
    position: sticky;
    top: 0;
    z-index: 10;
  }

  nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    max-width: 800px;
    margin: 0 auto;
  }

  .site-title {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--fg);
    text-decoration: none;
    letter-spacing: -0.02em;
  }

  .site-logo {
    width: 32px;
    height: 32px;
    border-radius: 4px;
    flex-shrink: 0;
  }

  .site-title:hover {
    color: var(--accent);
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-links a {
    font-size: 1.3rem;
    font-weight: 400;
    color: var(--muted);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .nav-links a:hover,
  .nav-links a.active {
    color: var(--fg);
    font-weight: 500;
  }

  @media (max-width: 640px) {
    header {
      padding: 0.75rem max(1rem, env(safe-area-inset-right)) 0.75rem max(1rem, env(safe-area-inset-left));
    }

    nav {
      flex-direction: column;
      align-items: stretch;
      gap: 0.625rem;
    }

    .site-title {
      justify-content: center;
      min-height: 44px;
      font-size: 1.35rem;
    }

    .nav-links {
      width: 100%;
      gap: 0.25rem;
    }

    .nav-links a {
      flex: 1;
      justify-content: center;
      min-width: 0;
      min-height: 44px;
      padding: 0.45rem 0.25rem;
      border-radius: 4px;
      font-size: 0.875rem;
      line-height: 1.2;
    }
  }
</style>
