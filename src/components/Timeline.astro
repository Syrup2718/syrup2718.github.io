---
interface TimelineItem {
  date: string;
  title: string;
  description?: string;
}

interface Props {
  items: TimelineItem[];
  align?: 'left' | 'alternate' | 'center';
}

const { items, align = 'left' } = Astro.props;
---

<div class="timeline" data-align={align}>
  {items.map((item, index) => (
    <div class="timeline-item">
      <div class="timeline-marker" />
      <div class="timeline-content">
        <time class="timeline-date">{item.date}</time>
        <h3 class="timeline-title">{item.title}</h3>
        {item.description && <p class="timeline-description">{item.description}</p>}
      </div>
    </div>
  ))}
</div>

<style>
  .timeline {
    position: relative;
    padding-left: 2rem;
    max-width: 800px;
    margin-bottom: 2rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 7px;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
    border-radius: 1px;
  }

  .timeline-item {
    position: relative;
    padding-bottom: 1.2rem;
  }

  .timeline-item:last-child {
    padding-bottom: 0;
  }

  .timeline-marker {
    position: absolute;
    left: -1.875rem;
    top: 0.55rem;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--accent);
    border: 3px solid var(--bg);
    box-shadow: 0 0 0 2px var(--accent);
    flex-shrink: 0;
    z-index: 1;
  }

  .timeline-content {
    padding-left: 1rem;
    padding-top: 0;
  }

  .timeline-date {
    display: inline-block;
    font-size: 1.1rem;
    font-weight: 600;
    color: var(--accent);
    margin-bottom: 0.1rem;
    margin-top: -1rem;
    font-variant-numeric: tabular-nums;
  }

  .timeline-title {
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--fg);
    line-height: 1.4;
  }

  .timeline-description {
    margin: 0;
    font-size: 0.9375rem;
    color: var(--muted);
    line-height: 1.7;
  }

  /* Alternate alignment */
  .timeline[data-align="alternate"] .timeline-item:nth-child(even) {
    padding-left: 50%;
  }

  .timeline[data-align="alternate"] .timeline-item:nth-child(even) .timeline-marker {
    left: calc(50% - 7px);
  }

  .timeline[data-align="alternate"] .timeline-item:nth-child(even)::before {
    content: '';
    position: absolute;
    left: calc(50% - 1px);
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--border);
  }

  .timeline[data-align="center"] .timeline-item {
    display: flex;
    align-items: flex-start;
  }

  .timeline[data-align="center"] .timeline-marker {
    left: calc(50% - 7px);
  }

  .timeline[data-align="center"] .timeline-content {
    width: calc(50% - 2rem);
    padding-left: 0;
  }

  .timeline[data-align="center"] .timeline-item:nth-child(even) .timeline-content {
    margin-left: auto;
    padding-left: 0;
    padding-right: 2rem;
    text-align: right;
  }

  .timeline[data-align="center"] .timeline-item:nth-child(even) .timeline-marker {
    left: calc(50% - 7px);
  }

  @media (max-width: 640px) {
    .timeline {
      padding-left: 1.5rem;
    }

    .timeline::before {
      left: 5px;
    }

    .timeline-marker {
      left: -1.625rem;
      width: 12px;
      height: 12px;
    }

    .timeline[data-align="alternate"] .timeline-item:nth-child(even),
    .timeline[data-align="center"] .timeline-item:nth-child(even) {
      padding-left: 0;
      text-align: left;
    }

    .timeline[data-align="alternate"] .timeline-item:nth-child(even) .timeline-marker,
    .timeline[data-align="center"] .timeline-item:nth-child(even) .timeline-marker {
      left: -1.625rem;
    }

    .timeline[data-align="center"] .timeline-item {
      display: block;
    }

    .timeline[data-align="center"] .timeline-content {
      width: 100%;
      padding-left: 1rem;
      padding-right: 0;
      text-align: left;
    }

    .timeline[data-align="alternate"] .timeline-item:nth-child(even)::before {
      display: none;
    }
  }
</style>