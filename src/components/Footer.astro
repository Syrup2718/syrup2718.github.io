---
const today = new Date();
const startDate = '2026-07-22T00:00:00+08:00';
---

<footer data-start-date={startDate}>  
  <p>&copy; {today.getFullYear()} 糖漿の小窩</p>

  <p class="uptime">
    已經陪伴你
    <span id="days">0</span>天
    <span id="hours">00</span>小時
    <span id="minutes">00</span>分
    <span id="seconds">00</span>秒啦！
  </p>
</footer>

<script>
  const footer = document.querySelector<HTMLElement>(
    'footer[data-start-date]'
  );

  const startDate = footer?.dataset.startDate;

  const daysElement = document.getElementById('days');
  const hoursElement = document.getElementById('hours');
  const minutesElement = document.getElementById('minutes');
  const secondsElement = document.getElementById('seconds');

  function updateUptime() {
    if (
      !startDate ||
      !daysElement ||
      !hoursElement ||
      !minutesElement ||
      !secondsElement
    ) {
      return;
    }

    const start = new Date(startDate).getTime();
    const now = Date.now();
    const diff = Math.max(0, now - start);

    const days = Math.floor(diff / (1000 * 60 * 60 * 24));
    const hours = Math.floor(
      (diff % (1000 * 60 * 60 * 24)) / (1000 * 60 * 60)
    );
    const minutes = Math.floor(
      (diff % (1000 * 60 * 60)) / (1000 * 60)
    );
    const seconds = Math.floor(
      (diff % (1000 * 60)) / 1000
    );

    daysElement.textContent = String(days);
    hoursElement.textContent = String(hours).padStart(2, '0');
    minutesElement.textContent = String(minutes).padStart(2, '0');
    secondsElement.textContent = String(seconds).padStart(2, '0');
  }

  updateUptime();
  window.setInterval(updateUptime, 1000);
</script>

<style>
  footer {
    padding: 2.5rem 1.5rem;
    border-top: 1px solid var(--border);
    text-align: center;
    color: var(--muted);
    font-size: 0.875rem;
    background: var(--bg);
  }

  .uptime {
    margin-top: 0.75rem;
    font-size: 0.8125rem;
    color: var(--accent);
  }

  .uptime span {
    font-weight: 500;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 640px) {
    footer {
      padding: 2rem 1rem;
      font-size: 0.8125rem;
    }

    .uptime {
      font-size: 0.75rem;
    }
  }
</style>