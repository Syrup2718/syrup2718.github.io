---
import { getCollection } from 'astro:content';

interface RawNode {
  id: string;
  type: 'tag' | 'blog' | 'project';
  label: string;
  url?: string;
}
interface RawEdge {
  source: string;
  target: string;
}

const posts = await getCollection('blog');
const projects = await getCollection('projects');

const tagContent = new Map<string, { label: string; items: { type: 'blog' | 'project'; id: string }[] }>();

function collect(tags: string[] | undefined, id: string, type: 'blog' | 'project') {
  if (!tags || tags.length === 0) return;
  for (const raw of tags) {
    const key = raw.trim().toLowerCase();
    if (!key) continue;
    let entry = tagContent.get(key);
    if (!entry) {
      entry = { label: raw.trim(), items: [] };
      tagContent.set(key, entry);
    }
    entry.items.push({ type, id });
  }
}

for (const p of posts) collect(p.data.tags, p.id, 'blog');
for (const p of projects) collect(p.data.tags, p.id, 'project');

const rawNodes: RawNode[] = [];
const rawEdges: RawEdge[] = [];

for (const [key, entry] of tagContent) {
  rawNodes.push({ id: `tag:${key}`, type: 'tag', label: entry.label });
  for (const item of entry.items) {
    rawEdges.push({ source: `tag:${key}`, target: `${item.type}:${item.id}` });
  }
}

const seen = new Set<string>();
for (const p of posts) {
  if (!p.data.tags || p.data.tags.length === 0) continue;
  const id = `blog:${p.id}`;
  if (seen.has(id)) continue;
  seen.add(id);
  rawNodes.push({ id, type: 'blog', label: p.data.title, url: `/blog/${p.id}/` });
}
for (const p of projects) {
  if (!p.data.tags || p.data.tags.length === 0) continue;
  const id = `project:${p.id}`;
  if (seen.has(id)) continue;
  seen.add(id);
  rawNodes.push({ id, type: 'project', label: p.data.title, url: `/projects/${p.id}/` });
}

const graphSummary = `${tagContent.size} 個標籤 · ${seen.size} 篇內容`;
const dataJson = JSON.stringify({ nodes: rawNodes, edges: rawEdges });
---

<div class="tag-graph" id="tag-graph" data-graph={dataJson} data-default-status={graphSummary}>
  <div class="tag-graph-toolbar">
    <p class="tag-graph-status" data-graph-status aria-live="polite">{graphSummary}</p>
    <div class="tag-graph-controls" aria-label="關聯圖檢視控制">
      <button type="button" data-graph-action="zoom-out" aria-label="縮小關聯圖">−</button>
      <button type="button" class="reset-view" data-graph-action="reset">重設</button>
      <button type="button" data-graph-action="zoom-in" aria-label="放大關聯圖">＋</button>
    </div>
  </div>

  <svg
    viewBox="0 0 900 560"
    role="group"
    aria-label="標籤關聯圖：標籤、文章與專案的關聯網路"
    aria-describedby="tag-graph-hint"
  >
    <rect class="graph-bg" width="900" height="560" rx="12" />
    <g class="graph-transform">
      <g class="graph-edges"></g>
      <g class="graph-nodes"></g>
    </g>
  </svg>

  <ul class="tag-graph-legend">
    <li><span class="lg-tag" />標籤</li>
    <li><span class="lg-blog" />筆記文章</li>
    <li><span class="lg-project" />專案</li>
  </ul>
  <p class="tag-graph-hint" id="tag-graph-hint">拖曳節點調整位置，點擊標籤查看關聯；鍵盤可用方向鍵切換節點</p>
</div>

<script>
  const graph = document.getElementById('tag-graph');
  if (graph) {
    const SVG_NS = 'http://www.w3.org/2000/svg';
    const compact = graph.getBoundingClientRect().width < 560;
    const W = compact ? 480 : 900;
    const H = compact ? 640 : 560;
    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const transformG = graph.querySelector('.graph-transform');
    const edgesG = graph.querySelector('.graph-edges');
    const nodesG = graph.querySelector('.graph-nodes');
    const bg = graph.querySelector<SVGRectElement>('.graph-bg');
    const svg = graph.querySelector<SVGSVGElement>('svg');
    const status = graph.querySelector<HTMLElement>('[data-graph-status]');
    const defaultStatus = graph.dataset.defaultStatus ?? '';

    svg?.setAttribute('viewBox', `0 0 ${W} ${H}`);
    bg?.setAttribute('width', String(W));
    bg?.setAttribute('height', String(H));

    const raw = JSON.parse(graph.getAttribute('data-graph') ?? '{"nodes":[],"edges":[]}');
    const tagNodes = raw.nodes.filter((n) => n.type === 'tag');
    const contentNodes = raw.nodes.filter((n) => n.type !== 'tag');
    const tagOrder = new Map(tagNodes.map((n, index) => [n.id, index]));
    const contentOrder = new Map(contentNodes.map((n, index) => [n.id, index]));

    const nodes = raw.nodes.map((n) => {
      const isTag = n.type === 'tag';
      const index = (isTag ? tagOrder : contentOrder).get(n.id) ?? 0;
      const count = Math.max(1, isTag ? tagNodes.length : contentNodes.length);
      const angle = (2 * Math.PI * index) / count - Math.PI / 2 + (isTag ? 0 : Math.PI / count);
      const alternateRing = index % 2 === 1;
      const radiusX = isTag
        ? (compact ? 175 : 330)
        : (compact ? (alternateRing ? 120 : 78) : (alternateRing ? 225 : 155));
      const radiusY = isTag
        ? (compact ? 255 : 210)
        : (compact ? (alternateRing ? 180 : 118) : (alternateRing ? 135 : 92));
      return {
        ...n,
        x: W / 2 + radiusX * Math.cos(angle),
        y: H / 2 + radiusY * Math.sin(angle),
        vx: 0,
        vy: 0,
        ax: 0,
        ay: 0,
        fx: null as number | null,
        fy: null as number | null,
        degree: 0,
        r: 5,
        el: null as SVGElement | null,
      };
    });
    const nodeById = new Map(nodes.map((n) => [n.id, n]));
    const edges = raw.edges.map((e) => ({ source: nodeById.get(e.source), target: nodeById.get(e.target), el: null as SVGElement | null })).filter((e) => e.source && e.target);

    nodes.forEach((n) => (n.degree = 0));
    edges.forEach((e) => {
      e.source!.degree++;
      e.target!.degree++;
    });
    nodes.forEach((n) => {
      const compactBoost = compact ? 1.5 : 0;
      n.r = n.type === 'tag'
        ? Math.min(17, 6.5 + n.degree * 1.4 + compactBoost)
        : Math.min(12, 5 + n.degree * 0.9 + compactBoost);
    });

    edges.forEach((e) => {
      const line = document.createElementNS(SVG_NS, 'line');
      line.setAttribute('class', 'edge');
      e.el = line;
      edgesG?.appendChild(line);
    });

    function compactLabel(label: string, limit: number) {
      return label.length > limit ? `${label.slice(0, limit - 1)}…` : label;
    }

    nodes.forEach((n, nodeIndex) => {
      const g = document.createElementNS(SVG_NS, 'g');
      let shape: SVGElement;
      if (n.type === 'project') {
        shape = document.createElementNS(SVG_NS, 'rect');
        shape.setAttribute('x', String(-n.r));
        shape.setAttribute('y', String(-n.r));
        shape.setAttribute('width', String(n.r * 2));
        shape.setAttribute('height', String(n.r * 2));
        shape.setAttribute('rx', '2');
      } else if (n.type === 'blog') {
        shape = document.createElementNS(SVG_NS, 'path');
        shape.setAttribute('d', `M0 ${-n.r} L${n.r} 0 L0 ${n.r} L${-n.r} 0 Z`);
      } else {
        shape = document.createElementNS(SVG_NS, 'circle');
        shape.setAttribute('r', String(n.r));
      }
      g.appendChild(shape);
      const title = document.createElementNS(SVG_NS, 'title');
      title.textContent = n.label;
      g.appendChild(title);
      const text = document.createElementNS(SVG_NS, 'text');
      text.setAttribute('text-anchor', 'middle');
      text.setAttribute('y', String(n.r + (compact ? 15 : 13)));
      text.textContent = compactLabel(n.label, n.type === 'tag' ? 15 : 18);
      g.appendChild(text);
      g.classList.add('node', `node-${n.type}`);
      g.setAttribute('tabindex', nodeIndex === 0 ? '0' : '-1');
      g.setAttribute('role', n.type === 'tag' ? 'button' : 'link');
      g.setAttribute(
        'aria-label',
        n.type === 'tag'
          ? `標籤 ${n.label}，${n.degree} 個關聯，按下聚焦`
          : `${n.type === 'blog' ? '筆記' : '專案'} ${n.label}，按下開啟`,
      );
      if (n.type === 'tag') g.setAttribute('aria-pressed', 'false');
      n.el = g;
      nodesG?.appendChild(g);

      g.addEventListener('pointerdown', (e) => startDrag(e, n));
      g.addEventListener('click', () => onNodeClick(n));
      g.addEventListener('mouseenter', () => hover(n));
      g.addEventListener('mouseleave', clearHover);
      g.addEventListener('focus', () => {
        setNodeTabStop(nodeIndex);
        hover(n);
      });
      g.addEventListener('blur', clearHover);
      g.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          onNodeClick(n);
          return;
        }

        const nextIndex =
          e.key === 'ArrowRight' || e.key === 'ArrowDown'
            ? nodeIndex + 1
            : e.key === 'ArrowLeft' || e.key === 'ArrowUp'
              ? nodeIndex - 1
              : e.key === 'Home'
                ? 0
                : e.key === 'End'
                  ? nodes.length - 1
                  : null;

        if (nextIndex != null) {
          e.preventDefault();
          focusNode(nextIndex);
        }
      });
    });

    function setNodeTabStop(index: number) {
      nodes.forEach((node, nodeIndex) => {
        node.el?.setAttribute('tabindex', nodeIndex === index ? '0' : '-1');
      });
    }

    function focusNode(index: number) {
      if (nodes.length === 0) return;
      const normalizedIndex = (index + nodes.length) % nodes.length;
      setNodeTabStop(normalizedIndex);
      nodes[normalizedIndex].el?.focus();
    }

    let tx = 0;
    let ty = 0;
    let k = 1;

    function applyTransform() {
      transformG?.setAttribute('transform', `translate(${tx} ${ty}) scale(${k})`);
    }

    function render() {
      edges.forEach((e) => {
        if (!e.el || !e.source || !e.target) return;
        e.el.setAttribute('x1', String(e.source.x));
        e.el.setAttribute('y1', String(e.source.y));
        e.el.setAttribute('x2', String(e.target.x));
        e.el.setAttribute('y2', String(e.target.y));
      });
      nodes.forEach((n) => {
        n.el?.setAttribute('transform', `translate(${n.x} ${n.y})`);
      });
    }

    const REPULSION = compact ? 4300 : 4000;
    const SPRING = compact ? 0.024 : 0.02;
    const REST = compact ? 92 : 130;
    const CENTER = compact ? 0.006 : 0.004;
    const DAMPING = 0.8;
    const BOUNDARY = compact ? 42 : 54;

    function step() {
      nodes.forEach((n) => {
        n.ax = 0;
        n.ay = 0;
      });
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const a = nodes[i];
          const b = nodes[j];
          let dx = a.x - b.x;
          let dy = a.y - b.y;
          let d2 = dx * dx + dy * dy;
          if (d2 < 1) {
            dx = Math.random() - 0.5;
            dy = Math.random() - 0.5;
            d2 = 1;
          }
          const d = Math.sqrt(d2);
          const f = REPULSION / d2;
          const bothContent = a.type !== 'tag' && b.type !== 'tag';
          const mixedTypes = (a.type === 'tag') !== (b.type === 'tag');
          const minimumDistance = bothContent
            ? (compact ? 78 : 94)
            : mixedTypes
              ? (compact ? 54 : 66)
              : a.r + b.r + (compact ? 22 : 16);
          const collision = d < minimumDistance ? (minimumDistance - d) * 0.09 : 0;
          const fx = (dx / d) * (f + collision);
          const fy = (dy / d) * (f + collision);
          a.ax += fx;
          a.ay += fy;
          b.ax -= fx;
          b.ay -= fy;
        }
      }
      edges.forEach((e) => {
        if (!e.source || !e.target) return;
        const dx = e.target.x - e.source.x;
        const dy = e.target.y - e.source.y;
        const d = Math.max(1, Math.sqrt(dx * dx + dy * dy));
        const f = (d - REST) * SPRING;
        const fx = (dx / d) * f;
        const fy = (dy / d) * f;
        e.source.ax += fx;
        e.source.ay += fy;
        e.target.ax -= fx;
        e.target.ay -= fy;
      });
      nodes.forEach((n) => {
        if (n.fx != null && n.fy != null) {
          n.x = n.fx;
          n.y = n.fy;
          n.vx = 0;
          n.vy = 0;
          return;
        }
        n.ax += (W / 2 - n.x) * CENTER;
        n.ay += (H / 2 - n.y) * CENTER;
        n.vx = (n.vx + n.ax) * DAMPING;
        n.vy = (n.vy + n.ay) * DAMPING;
        n.x += n.vx;
        n.y += n.vy;
        n.x = Math.max(BOUNDARY, Math.min(W - BOUNDARY, n.x));
        n.y = Math.max(BOUNDARY, Math.min(H - BOUNDARY, n.y));
      });
    }

    let running = false;
    let raf = 0;

    function startSimulation() {
      if (running || prefersReduced) return;
      running = true;
      let idleFrames = 0;
      function loop() {
        step();
        render();
        let speed = 0;
        nodes.forEach((n) => (speed += Math.abs(n.vx) + Math.abs(n.vy)));
        idleFrames = speed < 0.08 ? idleFrames + 1 : 0;
        if (idleFrames > 40) {
          running = false;
          return;
        }
        raf = requestAnimationFrame(loop);
      }
      raf = requestAnimationFrame(loop);
    }

    function settle() {
      if (prefersReduced) {
        for (let i = 0; i < 900; i++) step();
        render();
      } else {
        startSimulation();
      }
    }

    let drag: { node: (typeof nodes)[number]; startX: number; startY: number; nodeX: number; nodeY: number; moved: boolean } | null = null;
    let suppressClick = false;
    let activePointerId: number | null = null;

    function capturePointer(e: PointerEvent) {
      activePointerId = e.pointerId;
      svg?.setPointerCapture(e.pointerId);
    }

    function startDrag(e: PointerEvent, n: (typeof nodes)[number]) {
      if (e.button !== 0) return;
      e.preventDefault();
      e.stopPropagation();
      capturePointer(e);
      drag = { node: n, startX: e.clientX, startY: e.clientY, nodeX: n.x, nodeY: n.y, moved: false };
      n.vx = 0;
      n.vy = 0;
      n.fx = n.x;
      n.fy = n.y;
      startSimulation();
    }

    let panning = false;
    let panStartX = 0;
    let panStartY = 0;
    let panTX = 0;
    let panTY = 0;

    svg?.addEventListener('pointermove', (e) => {
      if (activePointerId !== e.pointerId) return;
      if (drag) {
        const rect = svg!.getBoundingClientRect();
        const dx = e.clientX - drag.startX;
        const dy = e.clientY - drag.startY;
        if (!drag.moved && Math.hypot(dx, dy) > 3) drag.moved = true;
        const nx = drag.nodeX + (dx * W) / rect.width / k;
        const ny = drag.nodeY + (dy * H) / rect.height / k;
        if (prefersReduced) {
          drag.node.x = nx;
          drag.node.y = ny;
          render();
        } else {
          drag.node.fx = nx;
          drag.node.fy = ny;
          if (!running) startSimulation();
        }
      } else if (panning) {
        const rect = svg!.getBoundingClientRect();
        tx = panTX + ((e.clientX - panStartX) * W) / rect.width;
        ty = panTY + ((e.clientY - panStartY) * H) / rect.height;
        applyTransform();
      }
    });

    function endPointer(e: PointerEvent) {
      if (activePointerId !== e.pointerId) return;
      if (drag) {
        suppressClick = drag.moved;
        if (drag.node) {
          drag.node.fx = null;
          drag.node.fy = null;
        }
        if (drag.moved) startSimulation();
        drag = null;
        window.setTimeout(() => (suppressClick = false), 0);
      }
      panning = false;
      if (bg) bg.style.cursor = 'grab';
      if (svg?.hasPointerCapture(e.pointerId)) svg.releasePointerCapture(e.pointerId);
      activePointerId = null;
    }

    svg?.addEventListener('pointerup', endPointer);
    svg?.addEventListener('pointercancel', endPointer);

    bg?.addEventListener('pointerdown', (e) => {
      if (e.button !== 0) return;
      capturePointer(e);
      panning = true;
      panStartX = e.clientX;
      panStartY = e.clientY;
      panTX = tx;
      panTY = ty;
      bg.style.cursor = 'grabbing';
      e.preventDefault();
    });

    svg?.addEventListener(
      'wheel',
      (e) => {
        e.preventDefault();
        const rect = svg.getBoundingClientRect();
        const vx = ((e.clientX - rect.left) / rect.width) * W;
        const vy = ((e.clientY - rect.top) / rect.height) * H;
        const factor = e.deltaY < 0 ? 1.12 : 1 / 1.12;
        const nk = Math.min(4, Math.max(0.4, k * factor));
        tx = vx - ((vx - tx) / k) * nk;
        ty = vy - ((vy - ty) / k) * nk;
        k = nk;
        applyTransform();
      },
      { passive: false },
    );

    bg?.addEventListener('dblclick', resetView);

    function setCamera(cx: number, cy: number, ck: number, animate: boolean) {
      const targetTX = W / 2 - ck * cx;
      const targetTY = H / 2 - ck * cy;
      if (animate && !prefersReduced) {
        const st = { tx, ty, k, t: performance.now(), dur: 320 };
        function tick(now: number) {
          const p = Math.min(1, (now - st.t) / st.dur);
          const e = 1 - Math.pow(1 - p, 3);
          tx = st.tx + (targetTX - st.tx) * e;
          ty = st.ty + (targetTY - st.ty) * e;
          k = st.k + (ck - st.k) * e;
          applyTransform();
          if (p < 1) requestAnimationFrame(tick);
        }
        requestAnimationFrame(tick);
      } else {
        tx = targetTX;
        ty = targetTY;
        k = ck;
        applyTransform();
      }
    }

    let focusedId: string | null = null;

    function setFocus(id: string | null) {
      focusedId = id;
      if (id) {
        const n = nodeById.get(id);
        if (n) setCamera(n.x, n.y, compact ? 1.55 : 1.7, true);
      }
      applyOpacity();
    }

    function resetView() {
      setFocus(null);
      setCamera(W / 2, H / 2, 1, true);
    }

    function zoomView(factor: number) {
      const centerX = (W / 2 - tx) / k;
      const centerY = (H / 2 - ty) / k;
      setCamera(centerX, centerY, Math.min(4, Math.max(0.55, k * factor)), true);
    }

    function applyOpacity() {
      if (!focusedId) {
        nodes.forEach((n) => {
          n.el?.classList.remove('hl', 'dim');
          if (n.type === 'tag') n.el?.setAttribute('aria-pressed', 'false');
        });
        edges.forEach((e) => e.el?.classList.remove('hl', 'dim'));
        if (status) status.textContent = defaultStatus;
        return;
      }
      const f = nodeById.get(focusedId);
      if (!f) return;
      const active = new Set<string>([focusedId]);
      edges.forEach((e) => {
        if (e.source === f) active.add(e.target!.id);
        if (e.target === f) active.add(e.source!.id);
      });
      nodes.forEach((n) => {
        const on = active.has(n.id);
        n.el?.classList.toggle('dim', !on);
        n.el?.classList.toggle('hl', n.id === focusedId);
        if (n.type === 'tag') n.el?.setAttribute('aria-pressed', String(n.id === focusedId));
      });
      edges.forEach((e) => {
        const on = e.source === f || e.target === f;
        e.el?.classList.toggle('dim', !on);
        e.el?.classList.toggle('hl', on);
      });
      if (status) status.textContent = `${f.label} · ${f.degree} 個關聯`;
    }

    function hover(n: (typeof nodes)[number]) {
      if (focusedId) return;
      if (status) {
        const typeLabel = n.type === 'tag' ? '標籤' : n.type === 'blog' ? '筆記' : '專案';
        status.textContent = `${typeLabel}「${n.label}」· ${n.degree} 個關聯`;
      }
      const active = new Set<string>([n.id]);
      edges.forEach((e) => {
        if (e.source === n) active.add(e.target!.id);
        if (e.target === n) active.add(e.source!.id);
      });
      nodes.forEach((x) => {
        const on = active.has(x.id);
        x.el?.classList.toggle('hl', on);
        x.el?.classList.toggle('dim', !on);
      });
      edges.forEach((e) => {
        const on = e.source === n || e.target === n;
        e.el?.classList.toggle('hl', on);
        e.el?.classList.toggle('dim', !on);
      });
    }

    function clearHover() {
      if (focusedId) return;
      nodes.forEach((n) => n.el?.classList.remove('hl', 'dim'));
      edges.forEach((e) => e.el?.classList.remove('hl', 'dim'));
      if (status) status.textContent = defaultStatus;
    }

    function onNodeClick(n: (typeof nodes)[number]) {
      if (suppressClick) return;
      if (n.type === 'tag') {
        if (focusedId === n.id) resetView();
        else setFocus(n.id);
      } else if (n.url) {
        window.location.href = n.url;
      }
    }

    graph.querySelectorAll<HTMLButtonElement>('[data-graph-action]').forEach((button) => {
      button.addEventListener('click', () => {
        const action = button.dataset.graphAction;
        if (action === 'zoom-in') zoomView(1.25);
        if (action === 'zoom-out') zoomView(1 / 1.25);
        if (action === 'reset') resetView();
      });
    });

    settle();
    render();
    applyTransform();
  }
</script>

<style>
  .tag-graph {
    max-width: 800px;
    margin: 0 auto;
  }

  .tag-graph-toolbar {
    display: flex;
    gap: 1rem;
    align-items: center;
    justify-content: space-between;
    min-height: 2.25rem;
    margin-bottom: 0.65rem;
  }

  .tag-graph-status {
    margin: 0;
    color: var(--muted);
    font-size: 0.8rem;
  }

  .tag-graph-controls {
    display: inline-flex;
    flex-shrink: 0;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--bg);
  }

  .tag-graph-controls button {
    display: grid;
    place-items: center;
    min-width: 2.75rem;
    height: 2.75rem;
    padding: 0 0.55rem;
    border: 0;
    border-left: 1px solid var(--border);
    color: var(--muted);
    background: transparent;
    font: inherit;
    font-size: 1rem;
    cursor: pointer;
  }

  .tag-graph-controls button:first-child {
    border-left: 0;
  }

  .tag-graph-controls .reset-view {
    font-size: 0.72rem;
  }

  .tag-graph-controls button:hover {
    color: var(--accent);
    background: var(--accent-light);
