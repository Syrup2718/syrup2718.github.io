---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../../consts';

const projects = (await getCollection('projects')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title="專案 | " + SITE_TITLE description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <header style="margin-bottom: 2.5rem;">
        <h1 style="font-size: clamp(2rem, 5vw, 2.75rem); margin-bottom: 0.5rem; font-weight: 500;">
          專案
        </h1>
        <p style="color: var(--muted); font-size: 1rem;">
          記錄一些做過的小專案，共 {projects.length} 個
        </p>
      </header>

      <ul style="list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--border);">
        {projects.map((project) => (
          <li style="padding: 1.75rem 0; border-bottom: 1px solid var(--border);">
            <article>
              <div style="display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.75rem;">
                <span style="font-size: 0.75rem; padding: 0.25rem 0.5rem; background: var(--accent-light); color: var(--accent); border-radius: 4px; font-weight: 500;">
                  {project.data.status}
                </span>
                {project.data.tags.map(tag => (
                  <span style="font-size: 0.75rem; padding: 0.25rem 0.5rem; background: var(--border); color: var(--muted); border-radius: 4px;">
                    {tag}
                  </span>
                ))}
              </div>
              <h2 style="margin: 0 0 0.5rem; font-size: 1.375rem; font-weight: 500; line-height: 1.3;">
                <a href={`/projects/${project.id}/`} style="color: inherit; text-decoration: none; transition: color 0.2s ease;" onmouseover="this.style.color='var(--accent)'" onmouseout="this.style.color='inherit'">
                  {project.data.title}
                </a>
              </h2>
              <p style="margin: 0 0 1rem; color: var(--muted); font-size: 1rem; line-height: 1.7;">
                {project.data.description}
              </p>
              <div style="display: flex; flex-wrap: wrap; gap: 1rem; font-size: 0.875rem;">
                <time style="color: var(--muted);">
                  {project.data.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
                  {project.data.updatedDate && ` · 更新於 ${project.data.updatedDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}`}
                </time>
                {project.data.github && (
                  <a href={project.data.github} target="_blank" rel="noopener" style="color: var(--accent);">
                    GitHub
                  </a>
                )}
                {project.data.demo && (
                  <a href={project.data.demo} target="_blank" rel="noopener" style="color: var(--accent);">
                    Demo
                  </a>
                )}
              </div>
            </article>
          </li>
        ))}
      </ul>

      {projects.length === 0 && (
        <p style="text-align: center; color: var(--muted); padding: 3rem 0;">
          還沒有專案喔，敬請期待
        </p>
      )}
    </main>
    <Footer />
  </body>
</html>