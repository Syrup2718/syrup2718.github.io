---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getCollection } from 'astro:content';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const projects = (await getCollection('projects'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);

const allPosts = await getCollection('blog');
const allProjects = await getCollection('projects');
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body>
    <Header />
    <main>
      <header style="margin-bottom: 4rem; text-align: center;">
        <h1 style="font-size: clamp(2.5rem, 6vw, 3.5rem); margin-bottom: 1rem; font-weight: 500; letter-spacing: -0.03em;">
          {SITE_TITLE}
        </h1>
        <p style="font-size: 1.125rem; color: var(--muted); max-width: 400px; margin: 0 auto; line-height: 1.6;">
          {SITE_DESCRIPTION}
        </p>
        <p style="margin-top: 1.5rem; font-size: 0.875rem; color: var(--muted-light);">
          共 {allPosts.length} 篇筆記 · {allProjects.length} 個專案
        </p>
      </header>

      {posts.length > 0 && (
        <section style="margin-bottom: 4rem;">
          <header style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem;">
            <h2 style="font-size: 1.25rem; font-weight: 500; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); flex: 1;">
              最近筆記
            </h2>
            <a href="/blog" style="font-size: 0.875rem; color: var(--accent); font-weight: 500; text-decoration: none;">
              查看全部 →
            </a>
          </header>
          <ul style="list-style: none; padding: 0; margin: 0;">
            {posts.map((post) => (
              <li style="padding: 1.5rem 0; border-top: 1px solid var(--border);">
                <a href={`/blog/${post.id}/`} style="display: block; text-decoration: none; color: inherit;">
                  <time style="display: block; font-size: 0.875rem; color: var(--muted); margin-bottom: 0.375rem;">
                    {post.data.pubDate.toLocaleDateString('zh-TW', { year: 'numeric', month: 'long', day: 'numeric' })}
                  </time>
                  <h3 style="margin: 0 0 0.5rem; font-size: 1.25rem; font-weight: 500; line-height: 1.3; transition: color 0.2s ease;">
                    {post.data.title}
                  </h3>
                  <p style="margin: 0; color: var(--muted); font-size: 0.9375rem; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    {post.data.description}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      {projects.length > 0 && (
        <section style="margin-bottom: 4rem;">
          <header style="display: flex; justify-content: space-between; align-items: baseline; margin-bottom: 1.5rem;">
            <h2 style="font-size: 1.25rem; font-weight: 500; padding-bottom: 0.75rem; border-bottom: 1px solid var(--border); flex: 1;">
              專案作品
            </h2>
            <a href="/projects" style="font-size: 0.875rem; color: var(--accent); font-weight: 500; text-decoration: none;">
              查看全部 →
            </a>
          </header>
          <ul style="list-style: none; padding: 0; margin: 0;">
            {projects.map((project) => (
              <li style="padding: 1.5rem 0; border-top: 1px solid var(--border);">
                <a href={`/projects/${project.id}/`} style="display: block; text-decoration: none; color: inherit;">
                  <div style="display: flex; flex-wrap: wrap; gap: 0.375rem; margin-bottom: 0.5rem;">
                    <span style="font-size: 0.75rem; padding: 0.2rem 0.5rem; background: var(--accent-light); color: var(--accent); border-radius: 4px; font-weight: 500;">
                      {project.data.status}
                    </span>
                    {project.data.tags.slice(0, 2).map(tag => (
                      <span style="font-size: 0.75rem; padding: 0.2rem 0.5rem; background: var(--border); color: var(--muted); border-radius: 4px;">
                        {tag}
                      </span>
                    ))}
                  </div>
                  <h3 style="margin: 0 0 0.5rem; font-size: 1.125rem; font-weight: 500; line-height: 1.3; transition: color 0.2s ease;">
                    {project.data.title}
                  </h3>
                  <p style="margin: 0; color: var(--muted); font-size: 0.9375rem; line-height: 1.6; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                    {project.data.description}
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <section style="text-align: center; padding: 2rem 0; border-top: 1px solid var(--border);">
        <h2 style="font-size: 1.125rem; font-weight: 500; margin-bottom: 1rem; color: var(--fg);">
          想看更多？
        </h2>
        <div style="display: flex; justify-content: center; gap: 1.5rem; flex-wrap: wrap;">
          <a href="/blog" style="padding: 0.75rem 1.5rem; background: var(--fg); color: var(--bg); border-radius: 6px; font-size: 0.9375rem; font-weight: 500; text-decoration: none; transition: opacity 0.2s ease;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
            瀏覽所有筆記
          </a>
          <a href="/projects" style="padding: 0.75rem 1.5rem; background: var(--accent); color: #fff; border-radius: 6px; font-size: 0.9375rem; font-weight: 500; text-decoration: none; transition: opacity 0.2s ease;" onmouseover="this.style.opacity='0.8'" onmouseout="this.style.opacity='1'">
            查看專案作品
          </a>
        </div>
      </section>
    </main>
    <Footer />
  </body>
</html>