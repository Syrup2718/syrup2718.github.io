---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import BookSpine from '../../components/BookSpine.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const books = (await getCollection('library')).sort(
  (a, b) => b.data.finishedDate.valueOf() - a.data.finishedDate.valueOf(),
);
const shelfSize = 9;
const shelves = Array.from(
  { length: Math.ceil(books.length / shelfSize) },
  (_, index) => books.slice(index * shelfSize, (index + 1) * shelfSize),
);
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <BaseHead title="秘密書房 | 糖漿の小窩" description="藏在小窩深處的私人閱讀書架。" />
    <meta name="robots" content="noindex, nofollow" />
  </head>
  <body>
    <Header />
    <main class="library-main">
      <header class="library-header">
        <p class="eyebrow">The hidden library</p>
        <h1>秘密書房</h1>
        <p>這裡收藏著讀過的故事，以及闔上書之後仍留在心裡的東西。</p>
      </header>

      <section class="library-tools" aria-label="搜尋藏書">
        <label for="library-search">找一本書</label>
        <div class="search-field">
          <i class="fa-solid fa-magnifying-glass" aria-hidden="true"></i>
          <input
            id="library-search"
            type="search"
            placeholder="搜尋書名、作者或標籤……"
            autocomplete="off"
            aria-controls="bookshelf"
          />
          <kbd>Esc</kbd>
        </div>
        <p id="search-status" aria-live="polite">書架上有 {books.length} 本藏書</p>
      </section>

      <section class="bookshelf-frame" aria-label="藏書書架">
        <div class="shelf-heading">
          <span>COLLECTION No. 2718</span>
          <span aria-hidden="true">✦</span>
        </div>

        <div id="bookshelf" class="bookshelf">
          {shelves.map((shelf, shelfIndex) => (
            <div class="shelf-row" data-shelf>
              <ol aria-label={`第 ${shelfIndex + 1} 層書架`}>
                {shelf.map((book, bookIndex) => (
                  <BookSpine book={book} index={shelfIndex * shelfSize + bookIndex} />
                ))}
              </ol>
            </div>
          ))}

          {books.length === 0 && (
            <div class="empty-library">
              <span aria-hidden="true">◇</span>
              <p>書架還是空的，等待第一本書入住。</p>
            </div>
          )}
        </div>

        <p class="no-results" data-no-results hidden>沒有找到符合的藏書。</p>
      </section>

      <footer class="library-exit">
        <a href="/about/">← 悄悄離開書房</a>
        <p>封面上的小金點代表示範藏書。</p>
      </footer>
    </main>
    <Footer />
  </body>
</html>

<script>
  const searchInput = document.querySelector<HTMLInputElement>('#library-search');
  const bookItems = Array.from(document.querySelectorAll<HTMLElement>('[data-book]'));
  const shelfRows = Array.from(document.querySelectorAll<HTMLElement>('[data-shelf]'));
  const status = document.querySelector<HTMLElement>('#search-status');
  const noResults = document.querySelector<HTMLElement>('[data-no-results]');

  function normalize(value: string) {
    return value.normalize('NFKC').toLocaleLowerCase('zh-TW').trim();
  }

  function filterBooks() {
    const query = normalize(searchInput?.value ?? '');
    let visibleCount = 0;

    for (const book of bookItems) {
      const matches = !query || normalize(book.dataset.search ?? '').includes(query);
      book.hidden = !matches;
      if (matches) visibleCount += 1;
    }

    for (const shelf of shelfRows) {
      const hasVisibleBook = Array.from(shelf.querySelectorAll<HTMLElement>('[data-book]'))
        .some((book) => !book.hidden);
      shelf.hidden = !hasVisibleBook;
    }

    if (status) {
      status.textContent = query
        ? `找到 ${visibleCount} 本藏書`
        : `書架上有 ${bookItems.length} 本藏書`;
    }
    if (noResults) noResults.hidden = visibleCount !== 0;
  }

  searchInput?.addEventListener('input', filterBooks);
  searchInput?.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') {
      searchInput.value = '';
      filterBooks();
      searchInput.blur();
    }
  });
</script>

<style>
  .library-main {
    max-width: 1080px;
    padding-top: 4rem;
  }

  .library-header {
    max-width: 620px;
    margin: 0 auto 3rem;
    text-align: center;
  }

  .library-header .eyebrow {
    margin-bottom: 0.4rem;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
  }

  .library-header h1 {
    margin-bottom: 0.8rem;
    font-size: clamp(2.5rem, 7vw, 4rem);
    font-weight: 500;
  }

  .library-header > p:last-child {
    margin: 0;
    color: var(--muted);
    font-size: 0.95rem;
  }

  .library-tools {
    max-width: 560px;
    margin: 0 auto 2.5rem;
  }

  .library-tools label {
    display: block;
    margin-bottom: 0.45rem;
    font-size: 0.78rem;
    color: var(--muted);
  }

  .search-field {
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: 0.7rem;
    align-items: center;
    padding: 0.7rem 0.9rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card);
  }

  .search-field:focus-within {
    border-color: var(--accent);
  }

  .search-field i {
    color: var(--muted-light);
    font-size: 0.8rem;
  }

  .search-field input {
    min-width: 0;
    border: 0;
    outline: 0;
    color: var(--fg);
    background: transparent;
    font: inherit;
    font-size: 0.88rem;
  }

  .search-field input::placeholder {
    color: var(--muted-light);
  }

  .search-field kbd {
    padding: 0.05rem 0.38rem;
    border: 1px solid var(--border);
    border-radius: 4px;
    color: var(--muted-light);
    background: var(--bg);
    font-family: inherit;
    font-size: 0.65rem;
  }

  #search-status {
    margin: 0.5rem 0 0;
    color: var(--muted-light);
    font-size: 0.72rem;
    text-align: center;
  }

  .bookshelf-frame {
    position: relative;
    padding: 1.2rem 1.2rem 1.6rem;
    border: 1px solid #d9cabe;
    border-radius: 8px;
    background: #f2ebe3;
  }

  .bookshelf-frame::before,
  .bookshelf-frame::after {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    width: 13px;
    background: #c8aa8d;
  }

  .bookshelf-frame::before { left: 0; }
  .bookshelf-frame::after { right: 0; }

  .shelf-heading {
    display: flex;
    justify-content: space-between;
    padding: 0.15rem 1rem 1rem;
    color: #937960;
    font-size: 0.68rem;
    letter-spacing: 0.16em;
  }

  .bookshelf {
    padding: 1.1rem 1rem 0;
    background:
      linear-gradient(90deg, rgba(119, 82, 53, 0.08), transparent 12%, transparent 88%, rgba(119, 82, 53, 0.08)),
      #f9f5ef;
  }

  .shelf-row {
    position: relative;
    min-height: 278px;
    padding: 1rem 1.3rem 20px;
  }

  .shelf-row::after {
    content: '';
    position: absolute;
    right: -1rem;
    bottom: 0;
    left: -1rem;
    height: 20px;
    border-top: 1px solid #a98769;
    border-bottom: 3px solid #a98769;
    background: linear-gradient(#d6b99c, #c5a281);
    box-shadow: 0 7px 0 rgba(96, 65, 42, 0.08);
  }

  .shelf-row ol {
    display: flex;
    align-items: flex-end;
    gap: 4px;
    min-height: 246px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .empty-library {
    display: grid;
    place-items: center;
    min-height: 320px;
    color: var(--muted);
    text-align: center;
  }

  .empty-library span {
    font-size: 2rem;
  }

  .empty-library p {
    margin: 0;
    font-size: 0.9rem;
  }

  .no-results {
    margin: 1.5rem 0 0;
    color: #937960;
    font-size: 0.85rem;
    text-align: center;
  }

  .library-exit {
    margin-top: 2rem;
    text-align: center;
  }

  .library-exit a {
    color: var(--muted);
    font-size: 0.82rem;
  }

  .library-exit p {
    margin: 0.55rem 0 0;
    color: var(--muted-light);
    font-size: 0.68rem;
  }

  [hidden] {
    display: none !important;
  }

  @media (max-width: 640px) {
    .library-main {
      padding-top: 2.5rem;
    }

    .library-header {
      margin-bottom: 2rem;
    }

    .bookshelf-frame {
      margin: 0 -0.35rem;
      padding-right: 0.7rem;
      padding-left: 0.7rem;
    }

    .bookshelf {
      padding-right: 0.25rem;
      padding-left: 0.25rem;
    }

    .shelf-row {
      min-height: 250px;
      padding-right: 0.4rem;
      padding-left: 0.4rem;
      overflow-x: auto;
    }

    .shelf-row ol {
      min-width: max-content;
      min-height: 218px;
    }

    .search-field kbd {
      display: none;
    }

    .search-field {
      grid-template-columns: auto 1fr;
    }
  }
</style>
